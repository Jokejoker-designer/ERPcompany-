# === Monorepo root — LOCAL secrets & data NEVER on GitHub ===

# Secrets / machine config
.env
.env.*
!.env.example
config.json
**/config.json
!**/config.example.json

# Databases & backups
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/data/**
!**/data/.gitkeep
**/backups/**
**/attachments/**
**/uploads/**

# Customer / year folders (local ERP only)
# Never commit scanned customer trees
**/Sân bay*/
**/CÔNG TY*/
**/cty */

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/env/
**/*.egg-info/
**/build/
# allow demo "build" scripts naming — ignore Python dist
apps/thanh-hoai-runtime/dist/

# Node / frontend demo
**/node_modules/
**/dist/
**/.output/
**/.nitro/
**/.tanstack/
**/.vercel/
*.local
.node_modules.lock

# Logs & OS
**/*.log
**/.DS_Store
**/Thumbs.db
**/_tmp_*.py
**/*.bak
**/*.old

# IDE / packaging noise
.idea/
.vscode/
*.swp
*.msi
**/deployment/winsw/logs/

# Screenshots / accidental dumps
screenshots/
attachments/
.project_id
